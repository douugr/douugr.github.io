---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { person, content } from '../data/profile';
import { htmlLang, ogLocale, langs, defaultLang, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Caminho equivalente desta página em cada idioma. */
  alternates: Record<Lang, string>;
  title?: string;
  description?: string;
}

const { lang, alternates, title = `${person.name} · ${content[lang].role}`, description = content[lang].headline } = Astro.props;
const t = useTranslations(lang);
const canonical = new URL(alternates[lang], Astro.site);
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={new URL(alternates[l], Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLang], Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wdth,wght@62..125,400..900&family=Dela+Gothic+One&family=Silkscreen&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-dvh overflow-x-clip font-sans">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-yellow focus:px-3 focus:py-2 focus:font-bold focus:text-ink">
      {t('skip')}
    </a>
    <Header lang={lang} alternates={alternates} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
