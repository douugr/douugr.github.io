---
interface Props {
  apps: { name: string; icon: string; href: string }[];
  class?: string;
}
const { apps, class: className = '' } = Astro.props;
---

<div class:list={['relative aspect-[9/19] w-full rounded-[2.4rem] border-[4px] border-ink bg-ink p-2', className]} style="box-shadow: 10px 10px 0 var(--color-red)">
  <div class="absolute top-4 left-1/2 z-10 h-5 w-20 -translate-x-1/2 rounded-full bg-ink"></div>
  <div class="relative flex h-full w-full flex-col overflow-hidden rounded-[1.9rem] bg-blue px-4 pt-12">
    <!-- mini capa no fundo da tela -->
    <div class="absolute -top-10 -right-12 size-44 rounded-full border-[3px] border-ink bg-yellow"></div>
    <div class="absolute right-0 bottom-0 h-1/2 w-full bg-red" style="clip-path: polygon(100% 0, 100% 100%, 0 100%)"></div>
    <div class="absolute inset-x-0 bottom-10 zigzag" style="--zz-color: var(--color-ink)"></div>
    <div class="absolute inset-x-0 bottom-0 h-10 bg-ink"></div>

    <p class="relative font-display text-4xl text-paper" style="text-shadow: 3px 3px 0 var(--color-ink)">9:41</p>
    <p class="relative font-pixel text-[10px] text-paper">player 1 · apps</p>
    <ul class="relative mt-6 grid grid-cols-3 items-start gap-x-1.5 gap-y-4">
      {
        apps.map((a) => (
          <li>
            <a href={a.href} class="flex flex-col items-center gap-1.5 transition hover:-translate-y-0.5">
              <img src={a.icon} alt="" width="256" height="256" class="print size-11 rounded-[22.5%] sm:size-12 border-[3px] border-ink" style="box-shadow: 3px 3px 0 var(--color-yellow)" />
              <span class="bg-ink px-1 text-center font-cond text-[9px] leading-tight tracking-wide text-paper uppercase sm:text-[10px]">{a.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="blink relative mt-auto mb-3.5 text-center font-pixel text-[10px] text-yellow">press start</p>
  </div>
</div>
