---
const links = [
  { href: '/#projetos', label: 'Projetos' },
  { href: '/#apps', label: 'Apps' },
  { href: '/#experiencia', label: 'Carreira' },
  { href: '/#stack', label: 'Stack' },
  { href: '/#contato', label: 'Contato' },
];
---

<header class="sticky top-0 z-40 border-b-[3px] border-ink bg-ink text-paper">
  <nav class="wrap flex h-14 items-center justify-between gap-4">
    <a href="/" class="shrink-0 font-pixel text-sm tracking-wider">
      douugr<span class="text-yellow">.dev.br</span>
    </a>
    <ul class="flex shrink-0 items-center gap-4 font-cond text-sm tracking-widest uppercase sm:gap-6 sm:text-base">
      {
        links.map((l, i) => (
          <li class:list={[i > 1 && 'hidden sm:block']}>
            <a href={l.href} class="decoration-yellow decoration-[3px] underline-offset-4 transition hover:text-yellow hover:underline">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
