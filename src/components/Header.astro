---
import { languages, langs, homePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}
const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const home = homePath(lang);
const links = [
  { href: `${home}#projetos`, label: t('nav.projects') },
  { href: `${home}#apps`, label: t('nav.apps') },
  { href: `${home}#experiencia`, label: t('nav.career') },
  { href: `${home}#voluntariado`, label: t('nav.volunteer') },
  { href: `${home}#stack`, label: t('nav.stack') },
  { href: `${home}#contato`, label: t('nav.contact') },
];
const menuShadows = ['blue', 'red', 'yellow', 'pink'];
---

<header class="sticky top-0 z-40 border-b-[3px] border-ink bg-ink text-paper">
  <nav class="wrap relative flex h-14 items-center justify-between gap-3">
    <a href={home} class="shrink-0 font-pixel text-xs tracking-wider sm:text-sm">
      douugr<span class="text-yellow">.dev.br</span>
    </a>

    <div class="flex shrink-0 items-center gap-3 sm:gap-5">
      <!-- menu completo (desktop) -->
      <ul class="hidden items-center gap-5 font-cond text-base tracking-widest uppercase lg:flex">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="decoration-yellow decoration-[3px] underline-offset-4 transition hover:text-yellow hover:underline">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- seletor de idioma -->
      <ul aria-label={t('lang.label')} class="flex border-2 border-paper/30 font-pixel text-[11px]">
        {
          langs.map((l) => (
            <li>
              <a
                href={alternates[l]}
                hreflang={l}
                lang={l}
                aria-current={l === lang ? 'true' : undefined}
                class:list={['block px-1.5 py-0.5 transition', l === lang ? 'bg-yellow text-ink' : 'text-paper/80 hover:bg-paper hover:text-ink']}
              >
                {languages[l]}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- menu hambúrguer (celular e tablet) -->
      <details id="mobile-menu" class="group lg:hidden">
        <summary
          aria-label={t('nav.menu')}
          class="flex size-9 cursor-pointer list-none items-center justify-center border-2 border-paper bg-ink transition hover:bg-yellow hover:text-ink group-open:bg-yellow group-open:text-ink [&::-webkit-details-marker]:hidden"
        >
          <svg class="size-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18" />
          </svg>
          <svg class="hidden size-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19" />
          </svg>
        </summary>

        <div class="absolute inset-x-0 top-full mt-[3px]">
          <div class="border-b-[3px] border-ink bg-ink px-4 pt-4 pb-6 sm:px-6">
            <p class="font-pixel text-[10px] text-yellow">select stage</p>
            <ul class="mt-3 grid gap-3 sm:grid-cols-2">
              {
                links.map((l, i) => (
                  <li>
                    <a
                      href={l.href}
                      class="hard-sm hard-hover flex items-center justify-between bg-paper px-4 py-2.5 font-cond text-2xl tracking-wider text-ink uppercase"
                      style={`--shadow: var(--color-${menuShadows[i % menuShadows.length]})`}
                    >
                      {l.label}
                      <span class="font-pixel text-[10px] text-muted">0{i + 1}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="zigzag down" style="--zz-color: var(--color-ink)"></div>
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  // Fecha o menu ao escolher um tópico, ao apertar Esc ou ao tocar fora dele.
  const menu = document.getElementById('mobile-menu') as HTMLDetailsElement | null;
  if (menu) {
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (menu.open = false)));
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>
