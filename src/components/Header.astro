---
const links = [
  { href: '/#apps', label: 'Apps' },
  { href: '/#experiencia', label: 'Experiência' },
  { href: '/#stack', label: 'Stack' },
  { href: '/#contato', label: 'Contato' },
];
---

<header class="sticky top-0 z-40 border-b border-border/60 bg-bg/80 backdrop-blur">
  <nav class="mx-auto flex h-14 max-w-5xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="font-mono text-sm font-medium tracking-tight">
      douugr<span class="text-accent">.dev.br</span>
    </a>
    <div class="flex items-center gap-1 sm:gap-4">
      <ul class="hidden items-center gap-5 text-sm text-muted sm:flex">
        {links.map((l) => <li><a href={l.href} class="transition hover:text-fg">{l.label}</a></li>)}
      </ul>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Alternar tema claro/escuro"
        class="rounded-md p-2 text-muted transition hover:bg-surface hover:text-fg"
      >
        <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
    </div>
  </nav>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });
</script>
