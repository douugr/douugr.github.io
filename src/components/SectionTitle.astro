---
interface Props {
  index: string;
  title: string;
  subtitle?: string;
}
const { index, title, subtitle } = Astro.props;
---

<div class="mb-10">
  <p class="font-mono text-xs text-accent">{index}</p>
  <h2 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
  {subtitle && <p class="mt-2 max-w-2xl text-muted">{subtitle}</p>}
</div>
