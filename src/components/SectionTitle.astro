---
interface Props {
  zone: string;
  title: string;
  kana?: string;
  subtitle?: string;
  shadow?: 'blue' | 'red' | 'yellow' | 'pink';
  inverse?: boolean;
}
const { zone, title, kana, subtitle, shadow = 'red', inverse = false } = Astro.props;
---

<div class="mb-12">
  <p class:list={['font-pixel text-xs tracking-widest', inverse ? 'text-yellow' : 'text-blue']}>{zone}</p>
  <div class="mt-3 flex flex-wrap items-end gap-x-4 gap-y-2">
    <h2
      class="inline-block -skew-x-6 -rotate-1 bg-ink px-4 pt-2 pb-1 font-cond text-4xl tracking-wide text-paper uppercase sm:text-5xl"
      style={`box-shadow: 6px 6px 0 var(--color-${shadow})`}
    >
      {title}
    </h2>
    {kana && <span class:list={['font-display text-sm', inverse ? 'text-paper/70' : 'text-ink/60']} lang="ja">{kana}</span>}
  </div>
  {subtitle && <p class:list={['mt-5 max-w-2xl text-lg', inverse ? 'text-paper/85' : 'text-muted']}>{subtitle}</p>}
</div>
