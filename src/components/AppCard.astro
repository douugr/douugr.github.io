---
import type { CollectionEntry } from 'astro:content';
import AppIcon from './AppIcon.astro';
import StoreBadges from './StoreBadges.astro';
import { apps, type AppKey } from '../data/apps';

interface Props {
  appKey: AppKey;
  projects: CollectionEntry<'projects'>[];
}
const { appKey, projects } = Astro.props;
const app = apps[appKey];
---

<article id={`app-${appKey}`} class="flex flex-col rounded-2xl border border-border bg-surface p-6">
  <div class="flex items-center gap-4">
    <AppIcon src={app.icon} alt={`Ícone do app ${app.name}`} class="size-16" />
    <div>
      <h3 class="text-lg font-semibold">{app.name}</h3>
      <p class="text-sm text-muted">{app.company}</p>
      <p class="mt-1 font-mono text-xs text-muted">★ {app.rating.toLocaleString('pt-BR')} · {app.ratingCount} avaliações</p>
    </div>
  </div>
  {
    projects.length > 0 && (
  <div class="mt-5">
    <p class="mb-2 text-xs font-medium tracking-wide text-muted uppercase">Projetos</p>
    <ul class="space-y-1 text-sm">
      {
        projects.map((p) => (
          <li>
            <a href={`/projetos/${p.id}/`} class="hover:text-accent">
              {p.data.title} <span class="font-mono text-xs text-muted">· {p.data.period}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
    )
  }
  <div class="mt-auto pt-5">
    <StoreBadges appStore={app.appStore} />
  </div>
</article>
