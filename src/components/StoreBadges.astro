---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  appStore?: string;
  lang: Lang;
}
const { appStore, lang } = Astro.props;
const t = useTranslations(lang);
---

{
  appStore && (
    <a
      href={appStore}
      target="_blank"
      rel="noopener"
      class="hard-sm hard-hover inline-flex items-center gap-2 bg-ink px-3 py-1.5 font-cond text-sm tracking-wider text-paper uppercase"
      style="--shadow: var(--color-blue)"
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.8-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9 0 0-2.7-1-2.6-4.1zM13.9 4.9c.7-.9 1.2-2 1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.3-.6 3.1-1.5z"/></svg>
      {t('store.cta')}
    </a>
  )
}
