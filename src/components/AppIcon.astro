---
interface Props {
  src: string;
  alt: string;
  class?: string;
  shadow?: 'blue' | 'red' | 'yellow' | 'pink';
}
const { src, alt, class: className = 'size-16', shadow = 'yellow' } = Astro.props;
---

<img
  src={src}
  alt={alt}
  width="256"
  height="256"
  loading="lazy"
  class:list={['print rounded-[22.5%] border-[3px] border-ink', className]}
  style={`box-shadow: 4px 4px 0 var(--color-${shadow})`}
/>
