---
import type { CollectionEntry } from 'astro:content';
import AppIcon from './AppIcon.astro';
import Tags from './Tags.astro';
import { apps } from '../data/apps';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { data } = project;
const app = data.app ? apps[data.app] : undefined;
const icon = data.icon ?? app?.icon;
---

<article class="relative flex flex-col rounded-2xl border border-border bg-surface p-6 transition hover:-translate-y-0.5 hover:border-accent/60">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="font-mono text-xs text-muted">{data.period}</p>
      <h3 class="mt-1 text-xl font-semibold">
        <a href={`/projetos/${project.id}/`} class="after:absolute after:inset-0">{data.title}</a>
      </h3>
      <p class="text-sm text-muted">
        {data.company}{data.client && <> · para {data.client}</>}
      </p>
    </div>
    {icon && <AppIcon src={icon} alt="" class="size-12 shrink-0" />}
  </div>
  <p class="mt-3 text-sm font-medium text-accent">{data.role} <span class="text-muted">· {data.kind}</span></p>
  <p class="mt-2 text-sm leading-relaxed text-muted">{data.summary}</p>
  {data.note && <p class="mt-3 text-xs text-muted italic">{data.note}</p>}
  <div class="mt-auto pt-4">
    <Tags items={data.stack} />
  </div>
</article>
