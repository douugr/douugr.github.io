---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AppIcon from '../../components/AppIcon.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import Tags from '../../components/Tags.astro';

export async function getStaticPaths() {
  const apps = await getCollection('apps', ({ data }) => !data.draft);
  return apps.map((app) => ({ params: { id: app.id }, props: { app } }));
}

const { app } = Astro.props;
const { Content } = await render(app);
---

<Base title={`${app.data.shortName} · Douglas Neto`} description={app.data.summary}>
  <article class="py-16">
    <a href="/#apps" class="font-mono text-xs text-muted transition hover:text-accent">← voltar para apps</a>

    <header class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-start">
      <AppIcon src={app.data.icon} alt={`Ícone do app ${app.data.shortName}`} class="size-24 shrink-0 sm:size-28" />
      <div>
        <p class="font-mono text-xs text-muted">{app.data.company} · {app.data.period}</p>
        <h1 class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">{app.data.title}</h1>
        <p class="mt-3 max-w-2xl text-lg text-muted">{app.data.summary}</p>
        <dl class="mt-6 flex flex-wrap gap-x-10 gap-y-4 text-sm">
          <div>
            <dt class="text-muted">Função</dt>
            <dd class="font-medium">{app.data.role}</dd>
          </div>
          <div>
            <dt class="text-muted">Plataforma</dt>
            <dd class="font-medium">{app.data.platforms.join(' · ')}</dd>
          </div>
          {
            app.data.rating && (
              <div>
                <dt class="text-muted">App Store</dt>
                <dd class="font-medium">★ {app.data.rating.toLocaleString('pt-BR')} · {app.data.ratingCount} avaliações</dd>
              </div>
            )
          }
        </dl>
        <div class="mt-6 space-y-4">
          <Tags items={app.data.stack} />
          <StoreBadges appStore={app.data.appStore} playStore={app.data.playStore} />
        </div>
      </div>
    </header>

    <div class="prose-case mt-16 max-w-2xl">
      <Content />
    </div>
  </article>
</Base>

<style>
  .prose-case :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .prose-case :global(p),
  .prose-case :global(li) {
    margin-top: 0.75rem;
    line-height: 1.75;
    color: var(--muted);
  }
  .prose-case :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose-case :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
