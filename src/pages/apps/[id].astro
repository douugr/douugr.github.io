---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PhoneMockup from '../../components/PhoneMockup.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import Tags from '../../components/Tags.astro';

export async function getStaticPaths() {
  const apps = await getCollection('apps', ({ data }) => !data.draft);
  return apps.map((app) => ({ params: { id: app.id }, props: { app } }));
}

const { app } = Astro.props;
const { Content } = await render(app);
---

<Base title={`${app.data.title} · douugr.dev.br`} description={app.data.summary}>
  <article class="py-16">
    <a href="/#apps" class="font-mono text-xs text-muted transition hover:text-accent">← voltar para apps</a>

    <header class="mt-8 grid items-center gap-10 md:grid-cols-[1.5fr_1fr]">
      <div>
        <p class="font-mono text-xs text-muted">{app.data.platforms.join(' · ')} · {app.data.year}</p>
        <h1 class="mt-2 text-4xl font-bold tracking-tight">{app.data.title}</h1>
        <p class="mt-3 text-lg text-muted">{app.data.summary}</p>
        <dl class="mt-6 grid grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-muted">Função</dt>
            <dd class="font-medium">{app.data.role}</dd>
          </div>
          {
            app.data.highlight && (
              <div>
                <dt class="text-muted">Destaque</dt>
                <dd class="font-medium text-accent">{app.data.highlight}</dd>
              </div>
            )
          }
        </dl>
        <div class="mt-6 space-y-4">
          <Tags items={app.data.stack} />
          <StoreBadges appStore={app.data.appStore} playStore={app.data.playStore} />
        </div>
      </div>
      <div class="mx-auto w-48">
        <PhoneMockup src={app.data.screenshot} alt={app.data.title} />
      </div>
    </header>

    <div class="prose-case mt-16 max-w-2xl">
      <Content />
    </div>
  </article>
</Base>

<style>
  .prose-case :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .prose-case :global(p),
  .prose-case :global(li) {
    margin-top: 0.75rem;
    line-height: 1.75;
    color: var(--muted);
  }
  .prose-case :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose-case :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
