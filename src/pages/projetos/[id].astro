---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AppIcon from '../../components/AppIcon.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import Tags from '../../components/Tags.astro';
import { apps } from '../../data/apps';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { data } = project;
const app = data.app ? apps[data.app] : undefined;
const icon = data.icon ?? app?.icon;
const { Content } = await render(project);
---

<Base title={`${data.title} · Douglas Neto`} description={data.summary}>
  <article class="py-16">
    <a href="/#projetos" class="font-mono text-xs text-muted transition hover:text-accent">← voltar para projetos</a>

    <header class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-start">
      {icon && <AppIcon src={icon} alt="" class="size-24 shrink-0 sm:size-28" />}
      <div>
        <p class="font-mono text-xs text-muted">{data.kind} · {data.period}</p>
        <h1 class="mt-1 text-3xl font-bold tracking-tight sm:text-4xl">{data.title}</h1>
        <p class="mt-3 max-w-2xl text-lg text-muted">{data.summary}</p>
        <dl class="mt-6 flex flex-wrap gap-x-10 gap-y-4 text-sm">
          <div>
            <dt class="text-muted">Função</dt>
            <dd class="font-medium">{data.role}</dd>
          </div>
          <div>
            <dt class="text-muted">Empresa</dt>
            <dd class="font-medium">{data.company}{data.client && <span class="text-muted"> · para {data.client}</span>}</dd>
          </div>
          {
            app && (
              <div>
                <dt class="text-muted">App</dt>
                <dd class="font-medium">{app.title}</dd>
              </div>
            )
          }
        </dl>
        {data.note && <p class="mt-4 text-sm text-muted italic">{data.note}</p>}
        <div class="mt-6 space-y-4">
          <Tags items={data.stack} />
          {app && <StoreBadges appStore={app.appStore} />}
        </div>
      </div>
    </header>

    <div class="prose-case mt-16 max-w-2xl">
      <Content />
    </div>
  </article>
</Base>

<style>
  .prose-case :global(h2) {
    margin-top: 2.5rem;
    font-size: 1.25rem;
    font-weight: 600;
  }
  .prose-case :global(p),
  .prose-case :global(li) {
    margin-top: 0.75rem;
    line-height: 1.75;
    color: var(--muted);
  }
  .prose-case :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .prose-case :global(a) {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
