---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionTitle from '../components/SectionTitle.astro';
import HomeScreen from '../components/HomeScreen.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AppCard from '../components/AppCard.astro';
import Tags from '../components/Tags.astro';
import { apps, type AppKey } from '../data/apps';
import { profile, experience, skills, education, certifications } from '../data/profile';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => b.data.start.valueOf() - a.data.start.valueOf());
const appKeys = Object.keys(apps) as AppKey[];
const homeApps = appKeys.map((key) => ({ name: apps[key].name, icon: apps[key].icon, href: `/#app-${key}` }));
---

<Base>
  <!-- Hero -->
  <section class="grid items-center gap-12 py-20 sm:py-28 md:grid-cols-[1.5fr_1fr]">
    <div>
      {
        profile.available && (
          <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs text-muted">
            <span class="size-2 animate-pulse rounded-full bg-emerald-500" />
            Aberto a novas oportunidades
          </p>
        )
      }
      <p class="font-mono text-sm text-accent">{profile.role}</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-balance sm:text-5xl">{profile.name}</h1>
      <p class="mt-4 text-xl text-balance text-muted sm:text-2xl">{profile.headline}</p>
      <p class="mt-6 max-w-xl leading-relaxed text-muted">{profile.bio}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#projetos" class="rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-bg transition hover:opacity-90">Ver projetos</a>
        <a href="#contato" class="rounded-lg border border-border px-4 py-2.5 text-sm font-medium transition hover:border-accent hover:text-accent">Contato</a>
      </div>
    </div>
    <div class="mx-auto w-60">
      <HomeScreen apps={homeApps} />
    </div>
  </section>

  <!-- Projetos -->
  <section id="projetos" class="scroll-mt-20 py-16">
    <SectionTitle index="01" title="Projetos" subtitle="Produtos de pagamento e banking em que atuei como desenvolvedor iOS, do mais recente ao mais antigo." />
    <div class="grid gap-6 md:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- Apps -->
  <section id="apps" class="scroll-mt-20 py-16">
    <SectionTitle index="02" title="Apps" subtitle="Onde esses projetos chegam às mãos de milhões de pessoas." />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {appKeys.map((key) => <AppCard appKey={key} projects={projects.filter((p) => p.data.app === key)} />)}
    </div>
  </section>

  <!-- Experiência -->
  <section id="experiencia" class="scroll-mt-20 py-16">
    <SectionTitle index="03" title="Experiência" />
    <ol class="relative space-y-10 border-l border-border pl-6">
      {
        experience.map((job) => (
          <li class="relative">
            <span class="absolute top-1.5 -left-[29px] size-2.5 rounded-full border-2 border-bg bg-accent" />
            <p class="font-mono text-xs text-muted">{job.period}</p>
            <h3 class="mt-1 font-semibold">
              {job.role} <span class="text-muted">· {job.company}</span>
            </h3>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{job.description}</p>
            <div class="mt-3">
              <Tags items={job.stack} />
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Stack -->
  <section id="stack" class="scroll-mt-20 py-16">
    <SectionTitle index="04" title="Stack & formação" />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        skills.map((s) => (
          <div class="rounded-2xl border border-border bg-surface p-5">
            <h3 class="mb-3 text-sm font-semibold">{s.group}</h3>
            <Tags items={s.items} />
          </div>
        ))
      }
      <div class="rounded-2xl border border-border bg-surface p-5">
        <h3 class="mb-3 text-sm font-semibold">Formação</h3>
        <ul class="space-y-2 text-sm">
          {
            education.map((e) => (
              <li>
                <span class="font-medium">{e.course}</span>
                <span class="block font-mono text-xs text-muted">{e.school} · {e.period}</span>
              </li>
            ))
          }
          {certifications.map((c) => <li class="text-muted">{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Contato -->
  <section id="contato" class="scroll-mt-20 py-16">
    <SectionTitle index="05" title="Vamos conversar?" subtitle={`Aberto a oportunidades em iOS, mentorias e boas ideias de app. ${profile.location}.`} />
    <div class="flex flex-wrap gap-3">
      <a href={`mailto:${profile.email}`} class="rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-bg transition hover:opacity-90">{profile.email}</a>
      <a href={profile.social.linkedin} target="_blank" rel="noopener" class="rounded-lg border border-border px-4 py-2.5 text-sm font-medium transition hover:border-accent hover:text-accent">LinkedIn</a>
      <a href={profile.social.github} target="_blank" rel="noopener" class="rounded-lg border border-border px-4 py-2.5 text-sm font-medium transition hover:border-accent hover:text-accent">GitHub</a>
      {
        profile.resumeUrl && (
          <a href={profile.resumeUrl} class="rounded-lg border border-border px-4 py-2.5 text-sm font-medium transition hover:border-accent hover:text-accent">Currículo (PDF)</a>
        )
      }
    </div>
  </section>
</Base>
