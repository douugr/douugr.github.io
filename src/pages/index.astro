---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import Tags from '../components/Tags.astro';
import { profile, experience, skills } from '../data/profile';

const apps = (await getCollection('apps', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <!-- Hero -->
  <section class="grid items-center gap-12 py-20 sm:py-28 md:grid-cols-[1.4fr_1fr]">
    <div>
      {
        profile.available && (
          <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs text-muted">
            <span class="size-2 animate-pulse rounded-full bg-emerald-500" />
            Aberto a novas oportunidades
          </p>
        )
      }
      <p class="font-mono text-sm text-accent">{profile.role}</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-balance sm:text-5xl">{profile.name}</h1>
      <p class="mt-4 text-xl text-balance text-muted sm:text-2xl">{profile.headline}</p>
      <p class="mt-6 max-w-xl leading-relaxed text-muted">{profile.bio}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#apps" class="rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-bg transition hover:opacity-90">Ver apps</a>
        <a href="#contato" class="rounded-lg border border-border px-4 py-2.5 text-sm font-medium transition hover:border-accent hover:text-accent">Contato</a>
      </div>
    </div>
    <div class="mx-auto hidden w-56 md:block">
      <PhoneMockup alt="app em destaque" src={apps[0]?.data.screenshot} class="rotate-3" />
    </div>
  </section>

  <!-- Apps -->
  <section id="apps" class="scroll-mt-20 py-16">
    <SectionTitle index="01" title="Apps em destaque" subtitle="Produtos que ajudei a construir e publicar nas lojas." />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        apps.map((app) => (
          <article class="group relative flex flex-col rounded-2xl border border-border bg-surface p-5 transition hover:border-accent/60">
            <div class="mx-auto mb-6 w-36">
              <PhoneMockup src={app.data.screenshot} alt={app.data.title} />
            </div>
            <div class="flex items-center justify-between font-mono text-xs text-muted">
              <span>{app.data.platforms.join(' · ')}</span>
              <span>{app.data.year}</span>
            </div>
            <h3 class="mt-2 text-lg font-semibold">
              <a href={`/apps/${app.id}/`} class="after:absolute after:inset-0">
                {app.data.title}
              </a>
            </h3>
            <p class="mt-1 text-sm text-muted">{app.data.summary}</p>
            {app.data.highlight && <p class="mt-3 text-sm font-medium text-accent">{app.data.highlight}</p>}
            <div class="mt-auto pt-4">
              <Tags items={app.data.stack} />
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Experiência -->
  <section id="experiencia" class="scroll-mt-20 py-16">
    <SectionTitle index="02" title="Experiência" />
    <ol class="relative space-y-10 border-l border-border pl-6">
      {
        experience.map((job) => (
          <li class="relative">
            <span class="absolute top-1.5 -left-[29px] size-2.5 rounded-full border-2 border-bg bg-accent" />
            <p class="font-mono text-xs text-muted">{job.period}</p>
            <h3 class="mt-1 font-semibold">
              {job.role} <span class="text-muted">· {job.company}</span>
            </h3>
            <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">{job.description}</p>
            <div class="mt-3">
              <Tags items={job.stack} />
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Stack -->
  <section id="stack" class="scroll-mt-20 py-16">
    <SectionTitle index="03" title="Stack" />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        skills.map((s) => (
          <div class="rounded-2xl border border-border bg-surface p-5">
            <h3 class="mb-3 text-sm font-semibold">{s.group}</h3>
            <Tags items={s.items} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- Contato -->
  <section id="contato" class="scroll-mt-20 py-16">
    <SectionTitle index="04" title="Vamos conversar?" subtitle="Aberto a vagas, freelas e boas ideias de app." />
    <div class="flex flex-wrap gap-3">
      <a href={`mailto:${profile.email}`} class="rounded-lg bg-accent px-4 py-2.5 text-sm font-medium text-bg transition hover:opacity-90">{profile.email}</a>
      <a href={profile.social.linkedin} target="_blank" rel="noopener" class="rounded-lg border border-border px-4 py-2.5 text-sm font-medium transition hover:border-accent hover:text-accent">LinkedIn</a>
      <a href={profile.social.github} target="_blank" rel="noopener" class="rounded-lg border border-border px-4 py-2.5 text-sm font-medium transition hover:border-accent hover:text-accent">GitHub</a>
      <a href={profile.resumeUrl} class="rounded-lg border border-border px-4 py-2.5 text-sm font-medium transition hover:border-accent hover:text-accent">Currículo (PDF)</a>
    </div>
  </section>
</Base>
